        "color_hex": "000000",
        "bold": true,
        "alignment": "left",
        "first_line_indent_chars": 0,
        "left_indent_pt": 0,
        "right_indent_pt": 0,
        "space_before_pt": 18,
        "space_after_pt": 9,
        "keep_with_next": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "二级标题使用显著黑体类层级并与正文分隔。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic"
    },
    {
      "id": "FMT-HEAD-303",
      "category": "heading",
      "selector": {
        "kind": "paragraph_role",
        "value": "level_3_section"
      },
