{
  "schema_version": "1.1",
  "profile_id": "technical-textbook-layout-v0.3.1-draft",
  "name": "理工科教材通用版式 V0.3.1 候选配置",
  "locale": "zh-CN",
  "scope": {
    "document_type": "monograph",
    "input_format": "DOCX",
    "notes": "基于两本钢结构教材的共同版式特征形成的可执行候选配置。扫描页仅用于相对布局观察；纸张尺寸沿用原 DOCX，比例边距需在真实可编辑样章上验证。"
  },
  "target_applications": [
    "Microsoft Word 2016",
    "Microsoft Word 2019",
    "Microsoft Word 2021",
    "Microsoft 365",
    "LibreOffice Writer"
  ],
  "runtime_policy": {
    "caller_requirements_highest": true,
    "editable_equations_required": true,
    "formula_image_policy": "block",
    "legacy_equation_policy": "qa",
    "field_rebuild_policy": "explicit_or_unambiguous"
  },
  "source_precedence": [
    "user_requirement",
    "written_requirement",
    "docx_template",
    "pdf_specification",
    "sample_book",
    "image",
    "text_note"
  ],
  "sources": [
    {
      "id": "SRC-301",
      "type": "user_requirement",
      "label": "项目用户确认的运行时规则",
      "summary": "任何调用者在当前任务中明确提出的格式要求及后续 QA 决定具有最高格式优先级；公式必须保持可编辑且不得转换为图片。当前基线要求目录和正文分别从阿拉伯数字 1 起排，正文跨章节连续，奇偶页均显示外侧页码。",
      "public": true
    },
    {
      "id": "SRC-302",
      "type": "sample_book",
      "label": "《钢结构基本原理（第三版）》版式样书",
      "locator": "Private scan; source pages, OCR, and local paths are not committed",
      "summary": "用于观察教材的前置部分、标题层级、运行页眉、图表公式、例题习题、附录和参考文献组织；扫描几何不作为准确页边距。",
      "public": false
    },
    {
      "id": "SRC-303",
      "type": "sample_book",
      "label": "《钢结构设计原理》版式样书",
      "locator": "Private scan; source pages, OCR, and local paths are not committed",
      "summary": "用于补充镜像版心比例、章节结构、按章编号、章末提要、参考文献和双栏索引等相对版式证据；扫描裁切不作为成品尺寸。",
      "public": false
    }
  ],
  "rules": [
    {
      "id": "FMT-PAGE-301",
      "category": "page",
      "selector": {
        "kind": "document",
        "value": "all_sections"
      },
      "properties": {
        "page_size_policy": "preserve",
        "mirror_margins": true,
        "margin_inner_ratio": 0.12,
        "margin_outer_ratio": 0.105,
        "margin_top_ratio": 0.096,
        "margin_bottom_ratio": 0.085,
        "header_distance_ratio": 0.055,
        "footer_distance_ratio": 0.05,
        "gutter_mm": 0,
        "different_first_page_header_footer": false,
        "odd_and_even_pages_header_footer": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "两本样书均呈镜像版心；精确毫米值受扫描影响，因此保持原纸张尺寸并采用待验证比例。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic",
      "notes": "比例边距为候选值；批准前必须用真实 DOCX 在目标应用中逐页验证。"
    },
    {
      "id": "FMT-BODY-301",
      "category": "body",
      "selector": {
        "kind": "paragraph_role",
        "value": "body_text"
      },
      "properties": {
        "font_name_east_asia": "宋体",
        "font_name_ascii": "Times New Roman",
        "font_name_complex_script": "Times New Roman",
        "font_size_pt": 10.5,
        "bold": false,
        "alignment": "justify",
        "line_spacing_rule": "exact",
        "line_spacing_pt": 18,
        "first_line_indent_chars": 2,
        "space_before_pt": 0,
        "space_after_pt": 0,
        "widow_control": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "两本教材正文均呈中文宋体类、西文衬线体、两端对齐和约两字首行缩进。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic"
    },
    {
      "id": "FMT-HEAD-301",
      "category": "heading",
      "selector": {
        "kind": "paragraph_role",
        "value": "chapter_title"
      },
      "properties": {
        "font_name_east_asia": "黑体",
        "font_name_ascii": "Arial",
        "font_name_complex_script": "Arial",
        "font_size_pt": 18,
        "color_hex": "000000",
        "bold": true,
        "alignment": "center",
        "first_line_indent_chars": 0,
        "left_indent_pt": 0,
        "right_indent_pt": 0,
        "space_before_pt": 24,
        "space_after_pt": 18,
        "page_break_before": true,
        "keep_with_next": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "章题为正文中最强层级，居中并留明显上下空白。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic"
    },
    {
      "id": "FMT-HEAD-302",
      "category": "heading",
      "selector": {
        "kind": "paragraph_role",
        "value": "level_2_section"
      },
      "properties": {
