      "confidence": "medium",
      "status": "draft",
      "application": "automatic"
    },
    {
      "id": "FMT-HEAD-304",
      "category": "heading",
      "selector": {
        "kind": "paragraph_role",
        "value": "level_4_section"
      },
      "properties": {
        "font_name_east_asia": "宋体",
        "font_name_ascii": "Times New Roman",
        "font_name_complex_script": "Times New Roman",
        "font_size_pt": 10.5,
        "color_hex": "000000",
        "bold": true,
        "alignment": "left",
        "first_line_indent_chars": 0,
        "left_indent_pt": 0,
        "right_indent_pt": 0,
        "space_before_pt": 9,
        "space_after_pt": 3,
        "keep_with_next": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "四级标题接近正文大小，以字重和段距区分。",
      "confidence": "low",
      "status": "draft",
      "application": "automatic"
    },
    {
      "id": "FMT-CAP-301",
      "category": "caption",
      "selector": {
        "kind": "caption_role",
        "value": "all"
      },
      "properties": {
        "font_name_east_asia": "宋体",
        "font_name_ascii": "Times New Roman",
        "font_name_complex_script": "Times New Roman",
        "font_size_pt": 9,
        "alignment": "center",
        "line_spacing_rule": "exact",
        "line_spacing_pt": 15,
        "space_before_pt": 0,
        "space_after_pt": 0,
        "numbering_mode": "manual_text",
        "preserve_identifier": true,
        "domain_context": "unknown",
        "allow_automatic_renumbering": false,
        "preserve_table_cell_caption_position": true
      },
      "source_ids": [
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "图题和表题均使用较小字号并居中；图题在下、表题在上。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic",
      "notes": "题注编号默认保留为可编辑人工文本；建筑、土木和结构工程内容中的剖面、节点、详图或图纸标识需结合语义逐项确认。"
    },
    {
      "id": "FMT-TABLE-301",
      "category": "table",
      "selector": {
        "kind": "table_role",
        "value": "all"
      },
      "properties": {
        "alignment": "center",
        "repeat_header_row": true,
        "prevent_row_split": true,
        "available_width_percent": 100,
        "allow_autofit": true,
        "cell_margins_mm": {
          "top": 1.0,
          "right": 1.5,
          "bottom": 1.0,
          "left": 1.5
        },
        "vertical_alignment": "center",
        "border_preset": "preserve",
        "font_name_east_asia": "宋体",
        "font_name_ascii": "Times New Roman",
        "font_size_pt": 9,
        "line_spacing_pt": 15,
        "header_bold": true
      },
      "source_ids": [
        "SRC-301",
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "跨页表应重复首行表头，普通数据行不得跨页拆分。",
      "confidence": "high",
      "status": "draft",
      "application": "automatic",
      "notes": "超高行必须允许拆分并报警；列角色、列宽、边框预设及横向分节仍须在结构映射中逐表批准。"
    },
    {
      "id": "FMT-FIELD-301",
      "category": "field",
      "selector": {
        "kind": "field_role",
        "value": "derived_fields"
      },
      "properties": {
        "update_on_open": true,
        "mark_fields_dirty": true,
        "convert_explicit_markers": true,
        "rebuild_heading_numbering": true,
        "heading_levels": 4,
        "strip_manual_heading_prefixes": true
      },
      "source_ids": [
        "SRC-301",
        "SRC-302",
        "SRC-303"
      ],
      "evidence_summary": "目录、页码、标题编号、题注和交叉引用应使用真实 Word 字段或关联样式的多级列表。",
      "confidence": "medium",
      "status": "draft",
      "application": "automatic",
      "notes": "仅转换明确标记或无歧义手工前缀；歧义内容必须进入阻塞 QA。"
    },
    {
      "id": "FMT-EQ-301",
      "category": "equation",
      "selector": {
        "kind": "equation_role",
        "value": "all"
      },
      "properties": {
        "require_editable_equations": true,
        "preserve_editable_objects": true,
        "block_formula_images": true
