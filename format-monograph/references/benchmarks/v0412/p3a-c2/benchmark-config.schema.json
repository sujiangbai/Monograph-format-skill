{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/benchmarks/v0412/p3a-c2/benchmark-config.schema.json",
  "title": "P3a-C2 Benchmark Configuration Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind", "contract_version", "headroom_factor", "support_ceiling",
    "scales", "scenarios", "generation", "repetitions", "rss_protocol",
    "thresholds", "total_reference_budget_hours"
  ],
  "properties": {
    "document_kind": {"const": "p3a_c2_benchmark_config"},
    "contract_version": {"const": "1.0"},
    "headroom_factor": {"const": 1.5},
    "support_ceiling": {"const": 2.0},
    "scales": {"type": "array", "minItems": 4, "maxItems": 4, "items": false, "prefixItems": [{"$ref": "#/$defs/scale_05"}, {"$ref": "#/$defs/scale_10"}, {"$ref": "#/$defs/scale_15"}, {"$ref": "#/$defs/scale_20"}]},
    "scenarios": {"type": "array", "minItems": 4, "maxItems": 4, "items": false, "prefixItems": [{"$ref": "#/$defs/disjoint"}, {"$ref": "#/$defs/subset_chain"}, {"$ref": "#/$defs/dense_crossing"}, {"$ref": "#/$defs/mixed_conflict_approval"}]},
    "generation": {"$ref": "#/$defs/generation"},
    "repetitions": {"$ref": "#/$defs/repetitions"},
    "rss_protocol": {"const": "external_supervisor_child_peak_working_set"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "total_reference_budget_hours": {"type": "number", "maximum": 3, "exclusiveMinimum": 0}
  },
  "$defs": {
    "scale": {
      "type": "object", "additionalProperties": false,
      "required": ["scale_id", "factor", "scenario_ids"],
      "properties": {
        "scale_id": {"type": "string", "enum": ["0.5x", "1.0x", "1.5x", "2.0x"]},
        "factor": {"type": "number", "enum": [0.5, 1.0, 1.5, 2.0]},
        "scenario_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["disjoint", "subset-chain", "dense-crossing", "mixed-conflict-approval"]}}
      }
    },
    "scale_05": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"scale_id": {"const": "0.5x"}, "factor": {"const": 0.5}}}]},
    "scale_10": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"scale_id": {"const": "1.0x"}, "factor": {"const": 1.0}}}]},
    "scale_15": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"scale_id": {"const": "1.5x"}, "factor": {"const": 1.5}}}]},
    "scale_20": {"allOf": [{"$ref": "#/$defs/scale"}, {"properties": {"scale_id": {"const": "2.0x"}, "factor": {"const": 2.0}}}]},
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "pre_approval_terminal", "post_approval_terminal", "final_requirement"],
      "properties": {
        "scenario_id": {"type": "string", "enum": ["disjoint", "subset-chain", "dense-crossing", "mixed-conflict-approval"]},
        "pre_approval_terminal": {"type": "string", "enum": ["final", "unresolvable", "awaiting_approval"]},
        "post_approval_terminal": {"type": "string", "enum": ["final", "unresolvable", "awaiting_approval"]},
        "final_requirement": {"type": "string", "enum": ["required", "forbidden", "conditional"]}
      }
    },
    "disjoint": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_id": {"const": "disjoint"}, "pre_approval_terminal": {"const": "final"}, "post_approval_terminal": {"const": "final"}, "final_requirement": {"const": "required"}}}]},
    "subset_chain": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_id": {"const": "subset-chain"}, "pre_approval_terminal": {"const": "final"}, "post_approval_terminal": {"const": "final"}, "final_requirement": {"const": "required"}}}]},
    "dense_crossing": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_id": {"const": "dense-crossing"}, "pre_approval_terminal": {"const": "unresolvable"}, "post_approval_terminal": {"const": "unresolvable"}, "final_requirement": {"const": "forbidden"}}}]},
    "mixed_conflict_approval": {"allOf": [{"$ref": "#/$defs/scenario"}, {"properties": {"scenario_id": {"const": "mixed-conflict-approval"}, "pre_approval_terminal": {"const": "awaiting_approval"}, "post_approval_terminal": {"const": "final"}, "final_requirement": {"const": "conditional"}}}]},
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_seed", "permutation_seeds", "rounding_policy", "generation_policy"],
      "properties": {
        "generation_seed": {"type": "integer", "minimum": 0},
        "permutation_seeds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "rounding_policy": {"const": "round_half_even"},
        "generation_policy": {"const": "deterministic_synthetic_v1"}
      }
    },
    "repetitions": {
      "type": "object", "additionalProperties": false,
      "required": ["warmup_runs", "measured_runs", "focus_repeat_scenarios"],
      "properties": {
        "warmup_runs": {"const": 1},
        "measured_runs": {"const": 3},
        "focus_repeat_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["disjoint", "subset-chain", "dense-crossing", "mixed-conflict-approval"]}}
      }
    },
    "limit": {
      "type": "object", "additionalProperties": false,
      "required": ["scale_id", "max_wall_seconds", "max_peak_rss_mib"],
      "properties": {
        "scale_id": {"type": "string", "enum": ["0.5x", "1.0x", "1.5x", "2.0x"]},
        "max_wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_peak_rss_mib": {"type": "integer", "minimum": 1}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["scale_limits", "wall_median_ratio_2x_to_1x", "rss_ratio_2x_to_1x", "output_json_ratio_2x_to_1x"],
      "properties": {
        "scale_limits": {"type": "array", "minItems": 4, "maxItems": 4, "items": false, "prefixItems": [
          {"allOf": [{"$ref": "#/$defs/limit"}, {"properties": {"scale_id": {"const": "0.5x"}, "max_wall_seconds": {"const": 60}, "max_peak_rss_mib": {"const": 512}}}]},
          {"allOf": [{"$ref": "#/$defs/limit"}, {"properties": {"scale_id": {"const": "1.0x"}, "max_wall_seconds": {"const": 60}, "max_peak_rss_mib": {"const": 512}}}]},
          {"allOf": [{"$ref": "#/$defs/limit"}, {"properties": {"scale_id": {"const": "1.5x"}, "max_wall_seconds": {"const": 60}, "max_peak_rss_mib": {"const": 512}}}]},
          {"allOf": [{"$ref": "#/$defs/limit"}, {"properties": {"scale_id": {"const": "2.0x"}, "max_wall_seconds": {"const": 120}, "max_peak_rss_mib": {"const": 1024}}}]}
        ]},
        "wall_median_ratio_2x_to_1x": {"const": 6},
        "rss_ratio_2x_to_1x": {"const": 3},
        "output_json_ratio_2x_to_1x": {"const": 3}
      }
    }
  }
}
