{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/benchmarks/v0412/p3a-c2/projected-envelope.schema.json",
  "title": "P3a-C2 Projected Envelope Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind", "contract_version", "projection_status",
    "compose_projection_strategy", "source_plan_digest", "derivation_policy",
    "unmodeled_dimensions", "decision_population_summary", "entries"
  ],
  "properties": {
    "document_kind": {"const": "p3a_c2_projected_envelope"},
    "contract_version": {"const": "1.0"},
    "projection_status": {"const": "planning_projection"},
    "compose_projection_strategy": {"const": "single_core_probe"},
    "source_plan_digest": {"$ref": "#/$defs/sha256_digest"},
    "derivation_policy": {"type": "string", "enum": ["manual_prediction_with_later_mechanical_validation"]},
    "unmodeled_dimensions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "decision_population_summary": {"$ref": "#/$defs/population_summary"},
    "entries": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "sha256_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "population_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["v041_primary", "v042_protected", "v043_protected"],
      "properties": {
        "v041_primary": {"const": 150},
        "v042_protected": {"const": 20},
        "v043_protected": {"const": 1}
      }
    },
    "projected_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_fragment", "binding", "key", "candidate"],
      "properties": {
        "rule_fragment": {"type": "integer", "minimum": 0},
        "binding": {"type": "integer", "minimum": 0},
        "key": {"type": "integer", "minimum": 0},
        "candidate": {"type": "integer", "minimum": 0}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "decision_id", "source_locator", "primary_version", "implementation_owner",
        "requirement_kind", "projected_counts", "scope_topology",
        "conflict_approval_assumption", "derivation_formula", "confidence",
        "zero_load_reason", "blocked_projection"
      ],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^V040-[A-Z0-9-]{3,96}$"},
        "source_locator": {"type": "string", "pattern": "^plan:[a-z0-9_-]{3,80}$"},
        "primary_version": {"type": "string", "enum": ["V0.4.1", "V0.4.2", "V0.4.3"]},
        "implementation_owner": {"type": "string", "enum": ["p3a_c", "p3a_r", "p3b_b", "p3b_o", "p4", "p5", "p6", "p7", "future_primary"]},
        "requirement_kind": {"type": "string", "enum": ["base_appearance", "system_projection", "protected_boundary"]},
        "projected_counts": {"$ref": "#/$defs/projected_counts"},
        "scope_topology": {"type": "string", "enum": ["single_core_probe", "unmodeled"]},
        "conflict_approval_assumption": {"type": "string", "enum": ["none", "approval_required", "unresolvable", "unmodeled"]},
        "derivation_formula": {"type": "string", "minLength": 1, "maxLength": 500},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "zero_load_reason": {"type": "string", "enum": ["none", "protected_boundary", "no_base_appearance", "synthetic_not_representative"]},
        "blocked_projection": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"primary_version": {"enum": ["V0.4.2", "V0.4.3"]}}},
          "then": {
            "properties": {
              "implementation_owner": {"const": "future_primary"},
              "requirement_kind": {"const": "protected_boundary"},
              "scope_topology": {"const": "unmodeled"},
              "conflict_approval_assumption": {"const": "unmodeled"},
              "zero_load_reason": {"const": "protected_boundary"},
              "blocked_projection": {"const": false},
              "projected_counts": {
                "properties": {"rule_fragment": {"const": 0}, "binding": {"const": 0}, "key": {"const": 0}, "candidate": {"const": 0}}
              }
            }
          }
        },
        {
          "if": {"properties": {"blocked_projection": {"const": true}}},
          "then": {"properties": {"zero_load_reason": {"const": "none"}, "scope_topology": {"const": "unmodeled"}, "conflict_approval_assumption": {"const": "unmodeled"}}}
        },
        {
          "if": {"properties": {"zero_load_reason": {"const": "none"}, "blocked_projection": {"const": false}}},
          "then": {"properties": {"scope_topology": {"const": "single_core_probe"}}}
        }
      ]
    }
  }
}
