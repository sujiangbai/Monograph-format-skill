{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/v2/layered-rule-asset.schema.json",
  "title": "Format Monograph V2 Layered Rule Asset",
  "type": "object",
  "additionalProperties": false,
  "x-read-compatible-minor-versions": [],
  "x-semantic-fingerprint-excludes": ["created_at", "display_name", "absolute_path"],
  "required": [
    "artifact_kind", "schema_version", "artifact_id", "created_by_tool",
    "input_fingerprints", "semantic_fingerprint", "layer_kind",
    "can_override_safety_invariants", "activation", "rules"
  ],
  "properties": {
    "artifact_kind": {"const": "layered-rule-asset"},
    "schema_version": {"const": "2.0"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "created_by_tool": {"$ref": "common.schema.json#/$defs/created_by_tool"},
    "input_fingerprints": {"$ref": "common.schema.json#/$defs/input_fingerprints"},
    "semantic_fingerprint": {"$ref": "common.schema.json#/$defs/semantic_fingerprint"},
    "layer_kind": {
      "type": "string",
      "enum": ["task_override", "publisher_template", "module", "book_type", "monograph_base", "standard_supplement"]
    },
    "can_override_safety_invariants": {"const": false},
    "activation": {"type": "string", "enum": ["draft", "approved", "disabled"]},
    "public_source_summary": {"type": "string", "maxLength": 1000},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "semantic_object_kind", "scope", "confidence", "status", "properties"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]{3,80}$"},
        "semantic_object_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "scope": {"$ref": "common.schema.json#/$defs/semantic_scope"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "property-catalog.generated.schema.json"}
        }
      }
    }
  }
}
