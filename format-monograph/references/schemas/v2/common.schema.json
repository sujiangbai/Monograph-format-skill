{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/v2/common.schema.json",
  "title": "Format Monograph V2 Common Contracts",
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}:[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "semantic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_by_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "version"],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][A-Za-z0-9.-]+)?$"
        }
      }
    },
    "input_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "role", "fingerprint"],
      "properties": {
        "input_id": {"$ref": "#/$defs/stable_id"},
        "role": {
          "type": "string",
          "enum": [
            "source_document",
            "rule_asset",
            "profile",
            "structure",
            "approval",
            "conflict_report",
            "capability",
            "ledger",
            "word_environment"
          ]
        },
        "fingerprint": {"$ref": "#/$defs/semantic_fingerprint"}
      }
    },
    "input_fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/input_fingerprint"}
    },
    "semantic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "scope_ids"],
      "properties": {
        "scope_kind": {
          "type": "string",
          "enum": ["document", "section", "chapter", "object", "property", "rule", "conflict"]
        },
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        }
      }
    },
    "typed_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "boolean"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "string"},
            "value": {"type": "string", "maxLength": 1000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "integer"},
            "value": {"type": "integer"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {"const": "decimal"},
            "value": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          }
        }
      ]
    },
    "safety_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overridable",
        "author_content_mutation_allowed",
        "legacy_auto_activation_allowed",
        "delivery_evidence_allowed",
        "final_ready_allowed"
      ],
      "properties": {
        "overridable": {"const": false},
        "author_content_mutation_allowed": {"const": false},
        "legacy_auto_activation_allowed": {"const": false},
        "delivery_evidence_allowed": {"const": false},
        "final_ready_allowed": {"const": false}
      }
    },
    "artifact_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_fingerprint",
        "input_fingerprint",
        "profile_fingerprint",
        "structure_fingerprint",
        "approval_fingerprints",
        "ledger_fingerprint",
        "word_environment_fingerprint"
      ],
      "properties": {
        "task_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"},
        "input_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"},
        "profile_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"},
        "structure_fingerprint": {"$ref": "#/$defs/semantic_fingerprint"},
        "approval_fingerprints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/semantic_fingerprint"}
        },
        "ledger_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/semantic_fingerprint"},
            {"type": "null"}
          ]
        },
        "word_environment_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/semantic_fingerprint"},
            {"type": "null"}
          ]
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "event_type", "created_at", "reason"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/stable_id"},
        "event_type": {
          "type": "string",
          "enum": ["created", "measured", "reviewed", "superseded"]
        },
        "created_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
