{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/v2/capability-snapshot.schema.json",
  "title": "Format Monograph V2 Capability Snapshot",
  "type": "object",
  "additionalProperties": false,
  "x-read-compatible-minor-versions": [],
  "required": [
    "artifact_kind", "schema_version", "artifact_id", "created_by_tool",
    "input_fingerprints", "semantic_fingerprint", "captured_at", "environment", "capabilities"
  ],
  "properties": {
    "artifact_kind": {"const": "capability-snapshot"},
    "schema_version": {"const": "2.0"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "created_by_tool": {"$ref": "common.schema.json#/$defs/created_by_tool"},
    "input_fingerprints": {"$ref": "common.schema.json#/$defs/input_fingerprints"},
    "semantic_fingerprint": {
      "$ref": "common.schema.json#/$defs/semantic_fingerprint",
      "x-semantic-fingerprint": "exclude"
    },
    "captured_at": {
      "type": "string", "format": "date-time",
      "x-semantic-fingerprint": "exclude"
    },
    "environment": {"$ref": "#/$defs/environment"},
    "capabilities": {
      "type": "array", "minItems": 1,
      "x-semantic-array": "set_by_key",
      "x-semantic-key": "capability_id",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os_family", "python_version"],
      "properties": {
        "os_family": {"type": "string", "enum": ["windows", "macos", "linux", "other"]},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "available"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}(?:\\.[a-z][a-z0-9-]{1,31})+$"},
        "available": {"type": "boolean"},
        "version": {"type": "string", "maxLength": 80},
        "evidence_summary": {"type": "string", "maxLength": 500}
      }
    }
  }
}
