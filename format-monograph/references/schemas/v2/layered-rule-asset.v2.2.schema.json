{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/v2.2/layered-rule-asset.schema.json",
  "title": "Format Monograph V2.2 Layered Rule Intent Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "registry_contract_version", "authority_contract_version", "artifact_id", "created_by_tool", "input_fingerprints", "semantic_fingerprint", "property_registry_binding", "layer_kind", "can_override_safety_invariants", "activation", "asset_scope", "allowed_semantic_object_kinds", "rules"],
  "properties": {
    "artifact_kind": {"const": "layered-rule-asset"},
    "schema_version": {"const": "2.2"},
    "registry_contract_version": {"const": "2.2"},
    "authority_contract_version": {"const": "1.0"},
    "artifact_id": {"$ref": "../v2.3/common.schema.json#/$defs/artifact_id"},
    "created_by_tool": {"$ref": "../v2.3/common.schema.json#/$defs/created_by_tool"},
    "input_fingerprints": {"$ref": "../v2.3/common.schema.json#/$defs/input_fingerprints"},
    "semantic_fingerprint": {"$ref": "../v2.3/common.schema.json#/$defs/semantic_fingerprint", "x-semantic-fingerprint": "exclude"},
    "property_registry_binding": {"$ref": "#/$defs/property_registry_binding"},
    "layer_kind": {"$ref": "../v2.3/common.schema.json#/$defs/layer_kind"},
    "can_override_safety_invariants": {"const": false},
    "activation": {"type": "string", "enum": ["draft", "approved", "disabled"]},
    "public_source_summary": {"type": "string", "maxLength": 1000},
    "asset_scope": {"$ref": "../v2.3/common.schema.json#/$defs/scope_expression"},
    "allowed_semantic_object_kinds": {"type": "array", "x-semantic-array": "set_by_scalar", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../v2.3/common.schema.json#/$defs/semantic_object_kind"}},
    "rules": {"type": "array", "x-semantic-array": "set_by_key", "x-semantic-key": "rule_id", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "property_registry_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["registry_fingerprint", "required_completeness"],
      "properties": {
        "registry_fingerprint": {"$ref": "../v2.3/common.schema.json#/$defs/semantic_fingerprint"},
        "required_completeness": {"type": "string", "enum": ["contract_core", "full_production"]}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "semantic_object_kind", "scope", "confidence", "status", "properties"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]{3,80}$"},
        "semantic_object_kind": {"$ref": "../v2.3/common.schema.json#/$defs/semantic_object_kind"},
        "scope": {"$ref": "../v2.3/common.schema.json#/$defs/scope_expression"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
        "properties": {"type": "array", "x-semantic-array": "set_by_key", "x-semantic-key": "property_id", "minItems": 1, "items": {"$ref": "property-catalog.generated.schema.json"}}
      }
    }
  }
}
