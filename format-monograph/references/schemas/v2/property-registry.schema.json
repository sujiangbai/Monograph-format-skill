{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.format-monograph.local/v2/property-registry.schema.json",
  "title": "Format Monograph V2 Property Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_scope",
    "data_types",
    "units",
    "normalizers",
    "comparators",
    "executor_capabilities",
    "auditor_capabilities",
    "properties"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "registry_id": {
      "type": "string",
      "pattern": "^registry:[a-z][a-z0-9-]{2,63}$"
    },
    "registry_scope": {"type": "string", "enum": ["production", "test"]},
    "data_types": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/data_type"}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "normalizers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/normalizer"}
    },
    "comparators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/comparator"}
    },
    "executor_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/executor_capability"}
    },
    "auditor_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/auditor_capability"}
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/property"}
    }
  },
  "$defs": {
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "data_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_type_id", "json_type"],
      "properties": {
        "data_type_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "json_type": {"type": "string", "enum": ["boolean", "string", "integer"]},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 200},
        "max_length": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "dimension", "symbol"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^unit\\.[a-z][a-z0-9-]{1,31}$"},
        "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "symbol": {"type": ["string", "null"], "maxLength": 16}
      }
    },
    "normalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizer_id", "description"],
      "properties": {
        "normalizer_id": {"type": "string", "pattern": "^normalizer\\.[a-z][a-z0-9-]{1,31}$"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparator_id", "description"],
      "properties": {
        "comparator_id": {"type": "string", "pattern": "^comparator\\.[a-z][a-z0-9-]{1,31}$"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "executor_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "description"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^executor\\.[a-z][a-z0-9-]{1,31}$"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "auditor_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "description"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^auditor\\.[a-z][a-z0-9-]{1,31}$"},
        "description": {"$ref": "#/$defs/description"}
      }
    },
    "comparison_precision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "decimal_places"},
        "value": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "test_only",
        "semantic_object_kinds",
        "allowed_layers",
        "data_type_id",
        "canonical_unit_id",
        "allowed_unit_ids",
        "comparison_precision",
        "normalizer_id",
        "comparator_id",
        "executor_capability_id",
        "auditor_capability_id",
        "overridable",
        "safety_invariant",
        "qa_required",
        "modes"
      ],
      "properties": {
        "property_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}(?:\\.[a-z][a-z0-9-]{1,31})+$"},
        "test_only": {"type": "boolean"},
        "semantic_object_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"}
        },
        "allowed_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["safety", "task_override", "publisher_template", "module", "book_type", "monograph_base", "standard_supplement"]
          }
        },
        "data_type_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "canonical_unit_id": {
          "oneOf": [
            {"type": "string", "pattern": "^unit\\.[a-z][a-z0-9-]{1,31}$"},
            {"type": "null"}
          ]
        },
        "allowed_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^unit\\.[a-z][a-z0-9-]{1,31}$"}
        },
        "comparison_precision": {
          "oneOf": [
            {"$ref": "#/$defs/comparison_precision"},
            {"type": "null"}
          ]
        },
        "normalizer_id": {"type": "string", "pattern": "^normalizer\\.[a-z][a-z0-9-]{1,31}$"},
        "comparator_id": {"type": "string", "pattern": "^comparator\\.[a-z][a-z0-9-]{1,31}$"},
        "executor_capability_id": {"type": "string", "pattern": "^executor\\.[a-z][a-z0-9-]{1,31}$"},
        "auditor_capability_id": {"type": "string", "pattern": "^auditor\\.[a-z][a-z0-9-]{1,31}$"},
        "overridable": {"type": "boolean"},
        "safety_invariant": {"type": "boolean"},
        "qa_required": {"type": "boolean"},
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["automatic", "preserve", "qa", "report", "block"]}
        }
      }
    }
  }
}
