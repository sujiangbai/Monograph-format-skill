{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sujiangbai/Monograph-format-skill/blob/main/format-monograph/references/format-profile.schema.json",
  "title": "Format Monograph Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "locale",
    "scope",
    "target_applications",
    "source_precedence",
    "sources",
    "rules",
    "conflicts",
    "open_questions",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_type",
        "input_format"
      ],
      "properties": {
        "document_type": {
          "const": "monograph"
        },
        "input_format": {
          "const": "DOCX"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "target_applications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Microsoft Word 2016",
          "Microsoft Word 2019",
          "Microsoft Word 2021",
          "Microsoft 365",
          "WPS Writer",
          "LibreOffice Writer"
        ]
      }
    },
    "source_precedence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "written_requirement",
          "docx_template",
          "pdf_specification",
          "sample_book",
          "image",
          "text_note"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "summary",
        "public"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[0-9]{3,}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "written_requirement",
            "docx_template",
            "pdf_specification",
            "sample_book",
            "image",
            "text_note"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "locator": {
          "type": "string",
          "maxLength": 500
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "public": {
          "type": "boolean"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "document",
            "section_role",
            "style_name",
            "paragraph_role",
            "table_role",
            "caption_role",
            "note_role",
            "bibliography_role",
            "appendix_role"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "selector",
        "properties",
        "source_ids",
        "evidence_summary",
        "confidence",
        "status",
        "application"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FMT-[A-Z0-9]+-[0-9]{3,}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "page",
            "section",
            "front_matter",
            "toc",
            "heading",
            "body",
            "header_footer",
            "figure",
            "table",
            "equation",
            "caption",
            "note",
            "bibliography",
            "appendix",
            "field"
          ]
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3,}$"
          }
        },
        "evidence_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "application": {
          "type": "string",
          "enum": [
            "automatic",
            "manual_review"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_ids",
        "summary",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CON-[0-9]{3,}$"
        },
        "rule_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "blocking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^QA-[0-9]{3,}$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "blocking": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "type": "string",
          "maxLength": 160
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
